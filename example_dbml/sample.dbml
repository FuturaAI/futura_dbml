// ============================================================
// Ecommerce - sample DBML
// ============================================================

TableGroup "Product Management" {
  products
  categories
  product_tags
  product_tags_map
  product_variants
}

TableGroup "Order Management" {
  orders
  order_items
  order_item_variants
  payment_transactions
  shipping_carriers
}

TableGroup "Wishlist Management" {
  wishlists
  wishlist_items
}

// ---- CORE ----

Table users {
  id int [pk, increment]
  full_name varchar
  email varchar [unique, not null]
  username varchar [unique, not null]
  password varchar [not null]
  phone_number varchar
  last_login timestamp
  avatar_url varchar
  created_at timestamp
  entry_code varchar
}

Table merchants {
  id int [pk, increment]
  country_code int [not null, ref: > countries.id]
  status orders_status [not null]
  merchant_name varchar
}

Table orders {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  status orders_status [not null]
  created_at varchar
  total_price decimal
  shipping_address varchar
  billing_address varchar
  payment_method varchar
  payment_status varchar
  shipping_carrier_id int [ref: > shipping_carriers.id]
}

Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  product_id int [not null, ref: > products.id]
  product_name varchar [not null]
  quantity int
  status orders_status [not null]
  price decimal
  image_url varchar
}

Table order_item_variants {
  id int [pk, increment]
  order_item_id int [not null, ref: > order_items.id]
  product_variant_id int [not null, ref: > product_variants.id]
}

Table payment_transactions {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  amount int
  status varchar
  created_at datetime
  payment_method varchar
  transaction_id varchar
}

Table shipping_carriers {
  id int [pk, increment]
  name varchar
  tracking_url varchar
}

Table promotions {
  id int [pk, increment]
  name varchar
  description varchar
  discount_percentage decimal
  start_date datetime [not null]
  end_date datetime [not null]
  product_id int [not null, ref: > products.id]
}

// ---- PRODUCT ----

Table products {
  id int [pk, increment]
  name varchar
  description varchar
  brand varchar
  color varchar
  weight float
  dimensions varchar
  rating float
  merchant_id int [not null, ref: > merchants.id]
  price decimal
  created_at datetime
  category_id int [ref: > categories.id]
  expiry_date datetime
}

Table categories {
  id int [pk, increment]
  name varchar
  parent_category_id int
}

Table product_tags {
  id int [pk, increment]
  name varchar
}

Table product_tags_map {
  product_id int [not null, ref: > products.id]
  tag_id int [not null, ref: > product_tags.id]
}

Table product_variants {
  id int [pk, increment]
  name varchar
  order_item_id int
  product_id int [not null, ref: > products.id]
}

// ---- WISHLIST ----

Table wishlists {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  name varchar
}

Table wishlist_items {
  id int [pk, increment]
  wishlist_id int [not null, ref: > wishlists.id]
  product_id int [not null, ref: > products.id]
  created_at datetime
}

// ---- CART ----

Table cart_items {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  quantity int
  created_at datetime
}

// ---- REVIEW ----

Table reviews {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  rating int
  comment varchar
  created_at datetime
}

// ---- INFO ----

Table countries {
  id int [pk, increment]
  name varchar [not null]
  code varchar [unique]
}
