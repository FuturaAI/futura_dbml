// ============================================================
// Ecommerce - sample DBML
// ============================================================

TableGroup "Product Management" {
  product.products
  product.categories
  product.product_tags
  product.product_tags_map
  product.product_variants
}

TableGroup "Order Management" {
  core.orders
  core.order_items
  core.order_item_variants
  core.payment_transactions
  core.shipping_carriers
}

TableGroup "Wishlist Management" {
  wishlist.wishlists
  wishlist.wishlist_items
}

// ---- CORE ----

Table core.users {
  id int [pk, increment]
  full_name varchar
  email varchar [unique, not null]
  username varchar [unique, not null]
  password varchar [not null]
  phone_number varchar
  last_login timestamp
  avatar_url varchar
  created_at timestamp
  entry_code varchar
}

Table core.merchants {
  id int [pk, increment]
  country_code int [not null, ref: > info.countries.id]
  status core.orders_status [not null]
  merchant_name varchar
}

Table core.orders {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  status core.orders_status [not null]
  created_at varchar
  total_price decimal
  shipping_address varchar
  billing_address varchar
  payment_method varchar
  payment_status varchar
  shipping_carrier_id int [ref: > core.shipping_carriers.id]
}

Table core.order_items {
  id int [pk, increment]
  order_id int [not null, ref: > core.orders.id]
  product_id int [not null, ref: > product.products.id]
  product_name varchar [not null]
  quantity int
  status core.orders_status [not null]
  price decimal
  image_url varchar
}

Table core.order_item_variants {
  id int [pk, increment]
  order_item_id int [not null, ref: > core.order_items.id]
  product_variant_id int [not null, ref: > product.product_variants.id]
}

Table core.payment_transactions {
  id int [pk, increment]
  order_id int [not null, ref: > core.orders.id]
  amount int
  status varchar
  created_at datetime
  payment_method varchar
  transaction_id varchar
}

Table core.shipping_carriers {
  id int [pk, increment]
  name varchar
  tracking_url varchar
}

Table core.promotions {
  id int [pk, increment]
  name varchar
  description varchar
  discount_percentage decimal
  start_date datetime [not null]
  end_date datetime [not null]
  product_id int [not null, ref: > product.products.id]
}

// ---- PRODUCT ----

Table product.products {
  id int [pk, increment]
  name varchar
  description varchar
  brand varchar
  color varchar
  weight float
  dimensions varchar
  rating float
  merchant_id int [not null, ref: > core.merchants.id]
  price decimal
  created_at datetime
  category_id int [ref: > product.categories.id]
  expiry_date datetime
}

Table product.categories {
  id int [pk, increment]
  name varchar
  parent_category_id int
}

Table product.product_tags {
  id int [pk, increment]
  name varchar
}

Table product.product_tags_map {
  product_id int [not null, ref: > product.products.id]
  tag_id int [not null, ref: > product.product_tags.id]
}

Table product.product_variants {
  id int [pk, increment]
  name varchar
  order_item_id int
  product_id int [not null, ref: > product.products.id]
}

// ---- WISHLIST ----

Table wishlist.wishlists {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  name varchar
}

Table wishlist.wishlist_items {
  id int [pk, increment]
  wishlist_id int [not null, ref: > wishlist.wishlists.id]
  product_id int [not null, ref: > product.products.id]
  created_at datetime
}

// ---- CART ----

Table cart.cart_items {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  product_id int [not null, ref: > product.products.id]
  quantity int
  created_at datetime
}

// ---- REVIEW ----

Table review.reviews {
  id int [pk, increment]
  user_id int [not null, ref: > core.users.id]
  product_id int [not null, ref: > product.products.id]
  rating int
  comment varchar
  created_at datetime
}

// ---- INFO ----

Table info.countries {
  id int [pk, increment]
  name varchar [not null]
  code varchar [unique]
}
