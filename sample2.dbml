// ──────────────────────────────────────────────────────────────────────────────
// Sample 2 – Famiglie prodotto + Vista UNION
//
// Le quattro tabelle hanno schema identico e possono essere combinate con:
//
//   SELECT id, name, price, brand, stock, category, created_at FROM electronics
//   UNION ALL
//   SELECT id, name, price, brand, stock, category, created_at FROM clothing
//   UNION ALL
//   SELECT id, name, price, brand, stock, category, created_at FROM food
//   UNION ALL
//   SELECT id, name, price, brand, stock, category, created_at FROM books
// ──────────────────────────────────────────────────────────────────────────────


// ── Famiglie prodotto ─────────────────────────────────────────────────────────

Table electronics [note: 'Articoli di elettronica'] {
  id         int           [pk, increment]
  name       varchar(255)  [not null]
  price      decimal(10,2) [not null]
  brand      varchar(100)
  stock      int           [not null, default: 0]
  category   varchar(50)   [not null, default: 'electronics']
  created_at datetime
}

Table clothing [note: 'Articoli di abbigliamento'] {
  id         int           [pk, increment]
  name       varchar(255)  [not null]
  price      decimal(10,2) [not null]
  brand      varchar(100)
  stock      int           [not null, default: 0]
  category   varchar(50)   [not null, default: 'clothing']
  created_at datetime
}

Table food [note: 'Articoli alimentari'] {
  id         int           [pk, increment]
  name       varchar(255)  [not null]
  price      decimal(10,2) [not null]
  brand      varchar(100)
  stock      int           [not null, default: 0]
  category   varchar(50)   [not null, default: 'food']
  created_at datetime
}

Table books [note: 'Libri e pubblicazioni'] {
  id         int           [pk, increment]
  name       varchar(255)  [not null]
  price      decimal(10,2) [not null]
  brand      varchar(100)
  stock      int           [not null, default: 0]
  category   varchar(50)   [not null, default: 'books']
  created_at datetime
}


// ── Vista UNION ───────────────────────────────────────────────────────────────

Table all_products [note: 'VIEW – UNION ALL delle quattro famiglie prodotto'] {
  id         int
  name       varchar(255)
  price      decimal(10,2)
  brand      varchar(100)
  stock      int
  category   varchar(50)
  created_at datetime
}


// ── Relazioni UNION (ogni famiglia alimenta la vista) ─────────────────────────

Ref: electronics.id > all_products.id
Ref: clothing.id    > all_products.id
Ref: food.id        > all_products.id
Ref: books.id       > all_products.id


// ── Gruppi ───────────────────────────────────────────────────────────────────

TableGroup "Famiglie Prodotto" {
  electronics
  clothing
  food
  books
}

TableGroup "Vista UNION" {
  all_products
}
